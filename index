            // =========================================================================
            if (page2Photos.length > 0) {
                // Cálculo de proporção para preencher a Página 2 sem deixar espaços vazios:
                let p2Cols = 2;
                let p2Height = "240px";

                if (page2Photos.length <= 4) {
                    p2Cols = 2;
                    p2Height = "240px"; // 4 fotos em 2x2 preenchem perfeitamente a página
                } else if (page2Photos.length <= 6) {
                    p2Cols = 3;
                    p2Height = "205px"; // 3 colunas em modo retrato equilibrado
                } else {
                    p2Cols = 3;
                    p2Height = "175px";
                }

                html += `
                    <div class="screen-page-divider">--- PÁGINA 2: CONTINUAÇÃO DO REGISTRO FOTOGRÁFICO & ASSINATURA ---</div>

                    <div class="html2pdf__page-break"></div>

                    <div class="doc-page">
                        <div class="doc-header" style="border-bottom-width: 2px;">
                            <div class="doc-brand">
                                <div class="doc-brand-icon" style="width:34px; height:34px; font-size:1rem;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3"><path d="M19 3L5 21M19 7L5 7M19 12L5 12M19 17L5 17"/></svg>
                                </div>
                                <div class="doc-title-area">
                                    <h2 style="font-size:0.95rem;">ANEXO FOTOGRÁFICO DE EVIDÊNCIAS DE AVARIAS</h2>
                                    <p style="font-size:0.7rem;">COMPLEMENTO TÉCNICO PERICIAL — LAUDO DE REPROVAÇÃO</p>
                                </div>
                            </div>
                            <div style="text-align: right; font-size: 7.5pt; color: #334155;">
                                <p><strong>LOTE:</strong> ${escapeHtml(lote)} | <strong>DOC:</strong> ${escapeHtml(docNum)}</p>
                                <p style="font-weight:700; color:var(--navy-900);">PÁGINA 2 DE 2</p>
                            </div>
                        </div>

                        <div class="doc-section-title" style="margin-top:0.4rem;">6. Registro Fotográfico Detalhado das Evidências (Continuação)</div>
                        
                        <div class="doc-photo-grid" style="grid-template-columns: repeat(${p2Cols}, 1fr);">
                            ${page2Photos.map(p => `
                                <div class="doc-photo-item">
                                    <img src="${p.src}" alt="${p.label}" style="height:${p2Height};">
                                    <span>${p.label}</span>
                                </div>
                            `).join('')}
                        </div>

                        ${signatureBlockHtml}
                    </div>
                `;
            }

            document.getElementById('printableReportArea').innerHTML = html;
            document.getElementById('reportModal').style.display = 'block';
            document.body.style.overflow = 'hidden';
        }

        function closeReportModal() {
            document.getElementById('reportModal').style.display = 'none';
            document.body.style.overflow = 'auto';
        }

        /**
         * BAIXA O PDF NOMEADO COM EXATAMENTE 2 PÁGINAS (SEM FOLHAS EM BRANCO)
         */
        function downloadPdfDirectly() {
            const lote = document.getElementById('ladderPatrimonio').value.trim() || document.getElementById('searchLote').value.trim() || 'SEM_LOTE';
            const element = document.getElementById('printableReportArea');
            const btnPdf = document.getElementById('btnPdfModal');

            const originalText = btnPdf ? btnPdf.innerHTML : '';
            if (btnPdf) {
                btnPdf.innerHTML = 'Gerando PDF...';
                btnPdf.disabled = true;
            }

            const opt = {
                margin:       [8, 10, 8, 10], // Margem A4 compacta (mm)
                filename:     `Laudo_Reprovacao_Escada_LOTE_${lote}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { 
                    scale: 2, 
                    useCORS: true, 
                    logging: false,
                    scrollY: 0
                },
                jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' },
                pagebreak:    { mode: ['css', 'legacy'], before: '.html2pdf__page-break' }
            };

            html2pdf().set(opt).from(element).save().then(() => {
                if (btnPdf) {
                    btnPdf.innerHTML = originalText;
                    btnPdf.disabled = false;
                }
            }).catch(err => {
                console.error("Erro ao gerar PDF:", err);
                if (btnPdf) {
                    btnPdf.innerHTML = originalText;
                    btnPdf.disabled = false;
                }
            });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str).replace(/[&<>'"]/g, tag => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                "'": '&#39;',
                '"': '&quot;'
            }[tag] || tag));
        }
    </script>
</body>
</html>
