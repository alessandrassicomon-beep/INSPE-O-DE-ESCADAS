        async function importExcelFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            const statusLabel = document.getElementById('dbStatusText');
            const btnUpload = document.getElementById('btnUploadExcel');

            statusLabel.textContent = "Processando planilha... Aguarde alguns instantes.";
            btnUpload.disabled = true;

            const reader = new FileReader();
            reader.onload = async function(e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array', cellDates: true, dateNF: 'dd/mm/yyyy' });
                    const firstSheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[firstSheetName];
                    const json = XLSX.utils.sheet_to_json(worksheet, { header: 1, raw: false });

                    if (!json || json.length < 2) {
                        alert("A planilha selecionada está vazia ou ilegível.");
                        btnUpload.disabled = false;
                        return;
                    }

                    const parsedList = [];
                    for (let i = 1; i < json.length; i++) {
                        const row = json[i];
                        if (!row || !row[3]) continue;

                        parsedList.push({
                            doc: String(row[0] || '').trim(),
                            produto: String(row[1] || '').trim(),
                            desc: String(row[2] || 'ESCADA DUPLA DE FIBRA 3.60X6.00 M').trim(),
                            lote: String(row[3] || '').trim(),
                            rt: String(row[4] || '').trim(),
                            re: String(row[5] || '').trim(),
                            executor: String(row[6] || '').trim(),
                            cargo: String(row[7] || '').trim(),
                            cc: String(row[8] || '').trim(),
                            tipo: String(row[9] || '').trim(),
                            qt: String(row[10] || '').trim(),
                            lancamento: String(row[11] || '').trim(),
                            base: String(row[12] || 'ITAQUERA').trim()
                        });
                    }

                    if (parsedList.length === 0) {
                        alert("Não foram encontrados dados válidos na Coluna D (Lote). Verifique a planilha.");
                        btnUpload.disabled = false;
                        return;
                    }

                    await saveInventoryToDB(parsedList);
                    populateInventoryMap(parsedList);

                    statusLabel.textContent = `Base Atualizada: ${parsedList.length.toLocaleString('pt-BR')} escadas salvas com sucesso!`;
                    alert(`Sucesso! ${parsedList.length.toLocaleString('pt-BR')} escadas foram importadas.`);
                } catch (err) {
                    console.error(err);
                    alert("Erro ao processar arquivo: " + err.message);
                    statusLabel.textContent = "Erro na importação.";
                } finally {
                    btnUpload.disabled = false;
                    event.target.value = '';
                }
            };

            reader.readAsArrayBuffer(file);
        }

